# Production settings for deploy/compose.prod.yaml. Copy to deploy/.env.prod on the server (chmod 600) and fill in.
# Never commit the filled-in file. Generate secrets with: openssl rand -base64 48

# --- the site
BONBON_DOMAIN=bonbon.example.vn
BONBON_WEB_URL=https://bonbon.example.vn
BONBON_CORS_ORIGINS=https://bonbon.example.vn
BONBON_WEB_IMAGE=bonbon-web:latest
BONBON_BACKEND_IMAGE=bonbon-backend:latest

# --- database (the container is created with these on first start)
POSTGRES_DB=bonbon
POSTGRES_USER=bonbon
POSTGRES_PASSWORD=change-me

# --- backend secrets
BONBON_JWT_SECRET=change-me-at-least-32-bytes
# 32 random bytes, base64 (openssl rand -base64 32); encrypts identity numbers and bank accounts. Never rotate blindly.
BONBON_DATA_KEY=change-me
# First administrator, created only when no admin exists yet.
ADMIN_SEED_EMAIL=admin@bonbon.example.vn
ADMIN_SEED_PASSWORD=change-me

# --- object storage (Cloudflare R2, S3 API)
BONBON_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BONBON_STORAGE_REGION=auto
BONBON_STORAGE_ACCESS_KEY=change-me
BONBON_STORAGE_SECRET_KEY=change-me
BONBON_STORAGE_PRIVATE_BUCKET=bonbon-private
BONBON_STORAGE_PUBLIC_BUCKET=bonbon-public
BONBON_STORAGE_PUBLIC_BASE_URL=https://cdn.bonbon.example.vn

# --- email (SMTP provider)
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change-me
SPRING_MAIL_PASSWORD=change-me
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
BONBON_MAIL_FROM=bonbon <no-reply@bonbon.example.vn>

# --- third parties
GOONG_API_KEY=change-me
GOOGLE_CLIENT_IDS=1083524871594-tim3ulsu19iegg7605ab0t4b7ca6onf0.apps.googleusercontent.com,1083524871594-2dpqinqn9opkekea75vm6gg0ttkfrf67.apps.googleusercontent.com
BONBON_CAPTCHA_ENABLED=true
BONBON_RECAPTCHA_SECRET=change-me

# --- MoMo (leave empty until there is a contract or sandbox account; cash on delivery still works)
BONBON_PAYMENT_PROVIDER=momo
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=https://bonbon.example.vn/payment/return
MOMO_IPN_URL=https://bonbon.example.vn/api/payments/momo/ipn

# --- backups (deploy/backup.sh)
BACKUP_DIR=/var/backups/bonbon
BACKUP_KEEP_DAYS=14
# Off-server copy to an R2/S3 bucket; leave BACKUP_S3_BUCKET empty to keep backups on the server only.
BACKUP_S3_BUCKET=bonbon-backups
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me
