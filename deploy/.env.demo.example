# Settings of the demo server for compose.prod.yaml + compose.demo.yaml. Copy to /opt/bonbon/.env.prod on the server
# (chmod 600), fill the blanks, never commit the filled-in file. Generate secrets on the server with the openssl commands shown.

# --- the site (DNS: A records for bonbon.pro.vn and *.bonbon.pro.vn to the VPS)
BONBON_DOMAIN=bonbon.pro.vn
BONBON_PUBLIC_URL=https://bonbon.pro.vn
BONBON_WEB_URL=https://bonbon.pro.vn
BONBON_CORS_ORIGINS=https://bonbon.pro.vn
# built and pushed by the Deploy workflows of bonbon-web and bonbon-backend
BONBON_WEB_IMAGE=ghcr.io/jzangtran/bonbon-web:latest
BONBON_BACKEND_IMAGE=ghcr.io/jzangtran/bonbon-backend:latest

# --- database: openssl rand -base64 24
POSTGRES_DB=bonbon
POSTGRES_USER=bonbon
POSTGRES_PASSWORD=

# --- backend secrets
# openssl rand -base64 48
BONBON_JWT_SECRET=
# openssl rand -base64 32 (keep a copy elsewhere: losing it makes the encrypted columns unreadable)
BONBON_DATA_KEY=
ADMIN_SEED_EMAIL=admin@bonbon.pro.vn
ADMIN_SEED_PASSWORD=

BONBON_CAPTCHA_ENABLED=false
BONBON_MAIL_FROM=bonbon demo <no-reply@bonbon.pro.vn>

# --- object storage (S3 API): a bucket pair of its own rather than the development ones
BONBON_STORAGE_ENDPOINT=https://s3.vn-hcm-1.vietnix.cloud
BONBON_STORAGE_REGION=vn-hcm-1
BONBON_STORAGE_ACCESS_KEY=
BONBON_STORAGE_SECRET_KEY=
BONBON_STORAGE_PRIVATE_BUCKET=bonbon-demo-private
BONBON_STORAGE_PUBLIC_BUCKET=bonbon-demo-public
BONBON_STORAGE_PUBLIC_BASE_URL=https://s3.vn-hcm-1.vietnix.cloud/bonbon-demo-public

# --- addresses: osm (no key), goong or openmap
BONBON_GEO_PROVIDER=osm
GOONG_API_KEY=
OPENMAP_API_KEY=
GOOGLE_CLIENT_IDS=

# --- backups (deploy/backup.sh); leave BACKUP_S3_BUCKET empty to keep them on the server only
BACKUP_DIR=/var/backups/bonbon
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=
