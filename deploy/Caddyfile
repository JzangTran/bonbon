# Edge of the production stack: HTTPS (automatic Let's Encrypt for BONBON_DOMAIN and its four subdomains), the API and its
# WebSocket proxied to the backend, everything else served from the web image's static files with SPA fallback.
# One web build serves every host and picks its pages from the host name (web/src/shared/config/sites.ts):
#   BONBON_DOMAIN public site, merchant.* sellers, help.* help center, console.* administrators, ops.* infrastructure.
#   developers.* the developer portal (the API reference, for developers an administrator approved).
# api.* is the API's own host: the base URL for the phone app and for developers. The web hosts keep /api on the same origin.
# Every name needs a DNS record pointing at this server before Caddy can get its certificate.

api.{$BONBON_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /ws/* {
		reverse_proxy backend:8080
	}
	# The OpenAPI document; the backend serves it only to an approved developer's token.
	handle /v3/api-docs* {
		reverse_proxy backend:8080
	}
	# Anyone opening the API host in a browser lands on the developer portal.
	handle / {
		redir https://developers.{$BONBON_DOMAIN} 302
	}
	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}
}

{$BONBON_DOMAIN}, merchant.{$BONBON_DOMAIN}, help.{$BONBON_DOMAIN}, console.{$BONBON_DOMAIN}, ops.{$BONBON_DOMAIN}, developers.{$BONBON_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /ws/* {
		reverse_proxy backend:8080
	}
	# The OpenAPI document for the developer portal (the backend checks the developer's token).
	handle /v3/api-docs* {
		reverse_proxy backend:8080
	}
	# Probes stay inside the compose network.
	handle /actuator/* {
		respond 404
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		# The web app loads Google sign-in and reCAPTCHA; images can come from the object storage's public URL.
		header @html Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com https://www.google.com https://www.gstatic.com; frame-src https://accounts.google.com https://www.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss: https://accounts.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}
