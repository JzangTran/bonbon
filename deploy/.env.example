# Copy to deploy/.env (never committed) and adjust. Values below are for local development only.

# --- docker compose (deploy/compose.dev.yaml) ---
POSTGRES_DB=bonbon
POSTGRES_USER=bonbon
POSTGRES_PASSWORD=bonbon
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
S3_PORT=9090

# --- backend (read by Spring Boot; export them or set them in your IDE run config) ---
SPRING_PROFILES_ACTIVE=dev
BONBON_DB_URL=jdbc:postgresql://localhost:5432/bonbon
BONBON_DB_USER=bonbon
BONBON_DB_PASSWORD=bonbon
BONBON_REDIS_HOST=localhost
BONBON_REDIS_PORT=6379
# HS256 secret, at least 32 bytes. Generate one: openssl rand -base64 48
BONBON_JWT_SECRET=
# AES-256 key for encrypted columns (identity numbers, bank accounts), 32 bytes base64: openssl rand -base64 32
# Keep it with the other secrets: losing it makes those columns unreadable.
BONBON_DATA_KEY=
BONBON_CORS_ORIGINS=http://localhost:5173
BONBON_WEB_URL=http://localhost:5173
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
# reCAPTCHA is off in the dev profile; production needs BONBON_RECAPTCHA_SECRET
BONBON_CAPTCHA_ENABLED=false
# First administrator, created once at startup if none exists
ADMIN_SEED_EMAIL=admin@bonbon.local
ADMIN_SEED_PASSWORD=
# Object storage (S3 API). Dev: the s3 service above (any key works). Prod: Cloudflare R2
# (endpoint https://<account-id>.r2.cloudflarestorage.com, region auto, an R2 API token's key pair).
BONBON_STORAGE_ENDPOINT=http://localhost:9090
BONBON_STORAGE_REGION=us-east-1
BONBON_STORAGE_ACCESS_KEY=dev
BONBON_STORAGE_SECRET_KEY=dev
BONBON_STORAGE_PRIVATE_BUCKET=bonbon-private
BONBON_STORAGE_PUBLIC_BUCKET=bonbon-public
# Base URL that serves the public bucket (prod: the R2 public bucket domain)
BONBON_STORAGE_PUBLIC_BASE_URL=http://localhost:9090/bonbon-public
# Goong REST API key (address suggestions and place details). Empty: a fake geocoder is used in the dev profile
GOONG_API_KEY=
